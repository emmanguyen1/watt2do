# AI Keys (Gemini Vision)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_SCAN=0

# Google Maps Platform Keys (Map & Places)
# Restricted to Maps JavaScript API & HTTP Referrers (http://localhost:5000/* and production domain)
GOOGLE_MAPS_BROWSER_KEY=

# Restricted to Places API (New) (Server-only, never sent to the browser)
GOOGLE_PLACES_SERVER_KEY=

# Local Server Config
FLASK_RUN_PORT=5000
PORT=5000
